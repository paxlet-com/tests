# syntax=docker/dockerfile:1
FROM python:3.12-slim

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    git \
    nodejs \
    npm \
    bubblewrap \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace

# Install pytest and runtime dependencies
RUN pip install --no-cache-dir pytest pydantic litellm requests pyyaml

ENV PYTHONPATH=/workspace/tests:/workspace/taskand:/workspace/paxlet:/workspace/nl-dsl-sh

ENTRYPOINT ["python", "-m", "unittest", "discover", "-s", "tests", "-p", "test_*.py"]
