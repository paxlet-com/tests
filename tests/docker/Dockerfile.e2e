FROM python:3.13-slim
RUN apt-get update && apt-get install -y --no-install-recommends nodejs ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY paxlet /inputs/paxlet
COPY nl-dsl-sh /inputs/nl-dsl-sh
RUN pip install --no-cache-dir /inputs/paxlet /inputs/nl-dsl-sh
COPY taskand /workspace/taskand
COPY tests /workspace/tests
COPY source-inventory.json /workspace/source-inventory.json
WORKDIR /workspace
ENV PYTHONPATH=/workspace/taskand:/workspace/tests PYTHONDONTWRITEBYTECODE=1
ENTRYPOINT ["python"]
CMD ["tests/run_local.py"]
